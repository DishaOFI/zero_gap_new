# Copy to .env and fill in.
N8N_URL=https://n8n.sofiatechnology.ai
N8N_API_KEY=                 # n8n -> Settings -> n8n API -> Create an API key
N8N_WORKFLOW_ARIS=           # ID of the flow "Zero Gap Agent – WITH ARIS context" (from its address: /workflow/<ID>)
N8N_WORKFLOW_ZERO=           # ID of the flow "Zero Gap Agent – ZERO context"
PORT=8000
PORTAL_USER=                 # optional: set both to protect the portal with a browser login
PORTAL_PASSWORD=
